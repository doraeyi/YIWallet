# 正式機用的環境變數範本。複製成 deploy/.env（docker compose 會自動讀取
# 同目錄的 .env），把值填好。所有密鑰都要重新產生，不要沿用 kaikaizhen
# 那份 dev 用的值。

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_USER=yiwallet
MYSQL_PASSWORD=

# --- 後端（FastAPI）---
# 這個是後端自己簽 JWT 用的密鑰，跟下面前端的 SESSION_SECRET 是兩把不同的鑰匙，不要搞混。
JWT_SECRET=
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Firebase 服務帳戶 JSON 本身不放在這裡，檔案直接放到
# deploy/secrets/firebase-adminsdk.json（compose 裡用 volume 掛進 backend）。

# --- 前端（Next.js）---
# 這個是前端幫瀏覽器簽 session cookie 用的密鑰，跟上面後端的 JWT_SECRET 是兩把不同的鑰匙。
SESSION_SECRET=
NEXT_PUBLIC_BASE_URL=https://正式機的網域
GOOGLE_CLIENT_SECRET=
GOOGLE_VISION_API_KEY=
OCR_SPACE_API_KEY=

# --- Firebase（前端 FCM 用，跟後端可以共用同一個 Firebase 專案）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
